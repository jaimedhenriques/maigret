  "components": [
    {
      "name": "Workspace primary button",
      "kind": "button",
      "refersTo": "workspace-button-primary",
      "description": "Native workspace action; specimen only, without API behavior.",
      "html": "<button class=\"ds-ws-primary\" type=\"button\">Invite candidate</button>",
      "css": ".ds-ws-primary{display:inline-flex;gap:8px;align-items:center;justify-content:center;min-height:44px;padding:11px 15px;border:1px solid #d5dbd0;border-radius:8px;text-decoration:none;cursor:pointer;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;line-height:1.4;transition:background 150ms ease,border-color 150ms ease,transform 100ms ease;background:var(--teal,#245642);color:#fff;border-color:var(--teal,#245642);}.ds-ws-primary:hover{background:var(--teal-dark,#183e2f);border-color:var(--teal-dark,#183e2f);}.ds-ws-primary:focus-visible{outline:3px solid var(--focus,#426e53);outline-offset:3px;}.ds-ws-primary:active{transform:scale(.985)}.ds-ws-primary:disabled{opacity:.62;cursor:not-allowed;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-ws-primary{transition:none}}"
    },
    {
      "name": "Workspace secondary button",
      "kind": "button",
      "refersTo": "workspace-button-secondary",
      "description": "Native workspace action; specimen only, without API behavior.",
      "html": "<button class=\"ds-ws-secondary\" type=\"button\">Export cases</button>",
      "css": ".ds-ws-secondary{display:inline-flex;gap:8px;align-items:center;justify-content:center;min-height:44px;padding:11px 15px;border:1px solid #d5dbd0;border-radius:8px;text-decoration:none;cursor:pointer;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;line-height:1.4;transition:background 150ms ease,border-color 150ms ease,transform 100ms ease;background:var(--white,#fff);color:var(--ink,#202723);}.ds-ws-secondary:hover{background:#eef2e9;border-color:#b8c5af;}.ds-ws-secondary:focus-visible{outline:3px solid var(--focus,#426e53);outline-offset:3px;}.ds-ws-secondary:active{transform:scale(.985)}.ds-ws-secondary:disabled{opacity:.62;cursor:not-allowed;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-ws-secondary{transition:none}}"
    },
    {
      "name": "Workspace danger button",
      "kind": "button",
      "refersTo": "workspace-button-danger",
      "description": "Native workspace action; specimen only, without API behavior.",
      "html": "<button class=\"ds-ws-danger\" type=\"button\">Withdraw from verification</button>",
      "css": ".ds-ws-danger{display:inline-flex;gap:8px;align-items:center;justify-content:center;min-height:44px;padding:11px 15px;border:1px solid #d5dbd0;border-radius:8px;text-decoration:none;cursor:pointer;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;line-height:1.4;transition:background 150ms ease,border-color 150ms ease,transform 100ms ease;background:var(--white,#fff);color:var(--danger,#963f35);border-color:#ddc4bc;}.ds-ws-danger:hover{background:#fbf0ec;border-color:#c49589;}.ds-ws-danger:focus-visible{outline:3px solid var(--focus,#426e53);outline-offset:3px;}.ds-ws-danger:active{transform:scale(.985)}.ds-ws-danger:disabled{opacity:.62;cursor:not-allowed;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-ws-danger{transition:none}}"
    },
    {
      "name": "Workspace text field",
      "kind": "input",
      "refersTo": "workspace-input",
      "description": "Labeled working field with hover, invalid and disabled treatment.",
      "html": "<label class=\"ds-field\" for=\"ds-work-email\">Work email<input id=\"ds-work-email\" type=\"email\" placeholder=\"you@company.com\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;color:var(--ink,#202723)}.ds-field input{width:100%;min-height:44px;padding:12px;border:1px solid #cfd6c8;border-radius:8px;background:#fff;color:var(--ink,#202723);font:400 13px var(--font,Manrope,Arial,sans-serif);transition:border-color 150ms ease}.ds-field input:hover{border-color:#97ab8b}.ds-field input:focus-visible{outline:3px solid var(--focus,#426e53);outline-offset:3px;}.ds-field input::placeholder{color:#72796d;opacity:1}.ds-field input[aria-invalid=true]{border-color:var(--danger,#963f35)}.ds-field input:disabled{background:#f1f3ec;color:#626960;cursor:not-allowed}@media(max-width:780px){.ds-field input{font-size:16px}}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
    },
    {
      "name": "Workspace active navigation",
      "kind": "nav",
      "refersTo": "workspace-navigation-active",
      "description": "Dark rail item; route action is illustrative.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Workspace specimen\"><a class=\"ds-nav\" href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M21 21v-3a6 6 0 0 0-4-5.65\"/></svg>Candidates</a></nav>",
      "css": ".ds-rail{background:#1c3027;padding:18px;font-family:var(--font,Manrope,Arial,sans-serif)}.ds-nav{display:flex;align-items:center;gap:11px;min-height:44px;padding:12px 11px;border-radius:8px;font-size:12px;font-weight:650;text-decoration:none;background:#385543;color:#fff;transition:background 150ms ease,color 150ms ease}.ds-nav svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{background:#2a4133}.ds-nav:focus-visible{outline:3px solid var(--focus,#426e53);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
    },
    {
      "name": "Workspace review badge",
      "kind": "chip",
      "refersTo": "workspace-status-review",
      "description": "Noninteractive status; its dot is decorative.",
      "html": "<span class=\"ds-review\">Needs review</span>",
      "css": ".ds-review{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:5px;background:var(--amber-bg,#fbf3df);color:#805818;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;white-space:nowrap}.ds-review::before{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Workspace panel",
      "kind": "card",
      "refersTo": "workspace-panel",
      "description": "Flat working container with a heading inset.",
      "html": "<section class=\"ds-panel\" aria-labelledby=\"ds-panel-title\"><div class=\"ds-panel-head\"><h2 id=\"ds-panel-title\">Candidate evidence</h2><p>Sources, reviewer notes and next steps.</p></div></section>",
      "css": ".ds-panel{background:var(--white,#fff);border:1px solid var(--line,#e3e5de);border-radius:var(--radius,14px);overflow:hidden;font-family:var(--font,Manrope,Arial,sans-serif);color:var(--ink,#202723)}.ds-panel-head{padding:23px 24px}.ds-panel h2{margin:0;font-size:16px;line-height:1.4;letter-spacing:-.025em}.ds-panel p{margin:5px 0 0;color:var(--muted,#626960);font-size:12px;line-height:1.6}"
    },
    {
      "name": "Landing primary button",
      "kind": "button",
      "refersTo": "landing-button-primary",
      "description": "Public page action; no destination behavior in this specimen.",
      "html": "<a class=\"ds-landing-primary\" href=\"#\">Explore the workspace</a>",
      "css": ".ds-landing-primary{display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:52px;padding:14px 22px;border:1px solid transparent;border-radius:8px;font-family:Manrope,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:650;line-height:1.4;text-decoration:none;background:var(--forest,#174d3b);color:#fff;transition:color 160ms ease-out,background-color 160ms ease-out,border-color 160ms ease-out,transform 100ms ease-out}.ds-landing-primary:hover{background:var(--forest-hover,#103d2e);}.ds-landing-primary:focus-visible{outline:3px solid var(--forest,#174d3b);outline-offset:5px}.ds-landing-primary:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-landing-primary{transition:none}.ds-landing-primary:active{transform:none}}"
    },
