{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "https://vetra-api-production-0262.up.railway.app/app"
    },
    {
      "source": "/login",
      "destination": "https://vetra-api-production-0262.up.railway.app/login"
    },
    {
      "source": "/logout",
      "destination": "https://vetra-api-production-0262.up.railway.app/logout"
    },
    {
      "source": "/candidate/:path*",
      "destination": "https://vetra-api-production-0262.up.railway.app/candidate/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vetra-api-production-0262.up.railway.app/api/:path*"
    },
    {
      "source": "/verification/:path*",
      "destination": "https://vetra-api-production-0262.up.railway.app/verification/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://vetra-api-production-0262.up.railway.app/healthz"
    },
    {
      "source": "/pilot",
      "destination": "https://vetra-api-production-0262.up.railway.app/pilot"
    },
    {
      "source": "/privacy",
      "destination": "https://vetra-api-production-0262.up.railway.app/privacy"
    },
    {
      "source": "/forgot-password",
      "destination": "https://vetra-api-production-0262.up.railway.app/forgot-password"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "https://vetra-api-production-0262.up.railway.app/reset-password/:path*"
    }
  ],
  "headers": [
    {
      "source": "/static/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
