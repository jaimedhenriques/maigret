# Copy these values into your deployment secret manager; the app does not read this file.
# The default local launcher uses fictional demo data and binds to loopback.
VETRA_DEMO=false
VETRA_DATABASE=/data/vetra.sqlite3
VETRA_SECRET_KEY=replace-with-a-random-stable-secret-of-at-least-32-characters
VETRA_ADMIN_EMAIL=owner@example.com
VETRA_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
VETRA_ADMIN_NAME=Workspace owner
VETRA_ORGANIZATION=Your organization
VETRA_PUBLIC_URL=https://your-deployed-domain.example

# Optional real Stripe Identity integration. Use restricted secrets where supported.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional partner workflow notifications (Standard Webhooks format, not Stripe).
# Use whsec_ followed by base64 of at least 32 random bytes.
# VETRA_WORKFLOW_WEBHOOK_SECRET=

# Commercial pilot: configure only after approved account and verified sender setup.
# STRIPE_PILOT_PRICE_ID=price_...
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# VETRA_EMAIL_FROM=
# VETRA_LEGAL_NAME=
# VETRA_LEGAL_ADDRESS=
# VETRA_PRIVACY_EMAIL=
# VETRA_RETENTION_DAYS=90
# VETRA_BACKUP_KEY=   # Fernet key; store separately from encrypted archives
